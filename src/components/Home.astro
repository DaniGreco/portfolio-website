---
import Base from '../layouts/Base.astro';
import Playground from './Playground/Playground.jsx';
import Reveal from './Reveal.astro';
import { COPY, LANGS } from '../i18n/home.js';

interface Props {
  lang: keyof typeof COPY;
}

const { lang } = Astro.props;
const t = COPY[lang];
const year = new Date().getFullYear();

// Experience and Studies share one screen, so both links point to it and light up together.
const nav = [
  { section: 'demo', links: [{ href: '#demo', label: t.nav.demo }] },
  { section: 'experience', links: [{ href: '#experience', label: t.nav.experience }, { href: '#studies', label: t.nav.studies }] },
  { section: 'contact', links: [{ href: '#contact', label: t.nav.contact }] },
];
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <header id="top-bar" class="sticky top-0 z-50 h-(--header) border-b border-white/60 bg-paper/35 backdrop-blur-md transition-[border-color,box-shadow] data-[scrolled]:border-ink/10 data-[scrolled]:shadow-[0_10px_30px_-24px_rgba(20,24,46,0.5)]">
    <!-- Phones get smaller type and gaps, so the name, the Italian quote button and the language switch fit on one line. -->
    <div class="mx-auto flex h-full max-w-[1400px] items-center justify-between gap-2 px-4 sm:gap-4 md:px-6">
      <a href="#top" class="wide-type text-[15px] font-extrabold tracking-tight whitespace-nowrap sm:text-[17px]" aria-label={t.bar.home}>
        <span class="sm:hidden" aria-hidden="true">Daniele G.</span><span class="hidden sm:inline">Daniele Greco</span><span class="hidden font-sans text-[15px] font-medium tracking-normal text-ink/60 xl:inline" style="font-stretch: 100%"> · {t.bar.role}</span>
      </a>
      <div class="flex items-center gap-2 sm:gap-3 lg:gap-5">
        <nav aria-label={t.bar.sections} class="hidden gap-4 text-[15px] font-semibold text-ink/65 md:flex lg:gap-6">
          {nav.map((group) => (
            <span class="nav-group relative inline-flex gap-4 lg:gap-6" data-section={group.section}>
              {group.links.map((link) => (
                <a href={link.href} class="py-1 hover:text-ink">{link.label}</a>
              ))}
            </span>
          ))}
        </nav>
        <a href={t.bar.quoteMail} class="rounded-full bg-ink px-3 py-2 text-[13px] font-semibold whitespace-nowrap text-white transition-colors hover:bg-traffic sm:px-4 sm:text-[15px]">
          {t.bar.quote}
        </a>
        <nav aria-label={t.bar.language} class="flex rounded-full border border-ink/15 bg-white/50 p-0.5 text-[13px] font-bold">
          {Object.entries(LANGS).map(([code, l]) => (
            <a
              href={l.path}
              hreflang={code}
              lang={code}
              title={l.name}
              data-lang-switch
              aria-current={code === lang ? 'page' : undefined}
              class:list={[
                'rounded-full px-2.5 py-1 transition-colors',
                code === lang ? 'bg-ink text-white' : 'text-ink/55 hover:text-ink',
              ]}
            >
              {l.label}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </header>

  <canvas id="background" class="pointer-events-none fixed inset-0 -z-10 h-dvh w-full" aria-hidden="true"></canvas>

  <main>
    <section id="top" class="snap hero relative flex flex-col">
      <div class="relative mx-auto flex w-full max-w-[1400px] flex-1 flex-col justify-center px-4 pt-6 pb-5 sm:pt-16 sm:pb-8 md:px-6">
        <div class="grid gap-6 sm:gap-8 lg:grid-cols-12 lg:items-end">
          <Reveal
            as="h1"
            text={t.hero.title}
            class="hero-in wide-type text-[clamp(1.85rem,3.7vw,3.5rem)] leading-[1.03] font-extrabold tracking-[-0.02em] text-balance lg:col-span-8"
          />
          <div class="hero-in fade-up glass p-5 sm:p-6 lg:col-span-4" style="--delay: 450ms">
            <p class="max-w-[44ch] text-[16.5px] leading-relaxed text-ink/80 sm:text-[18px] [&_strong]:font-bold [&_strong]:text-ink" set:html={t.hero.intro} />
            <ul class="mt-5 flex flex-wrap gap-2.5 text-[15px] font-semibold sm:mt-6">
              <li>
                <a href="https://danielegreco.com/github" class="inline-flex rounded-full border border-ink/15 bg-white px-4 py-2 transition-colors hover:border-ink/45">GitHub</a>
              </li>
              <li>
                <a href="https://danielegreco.com/linkedin" class="inline-flex rounded-full border border-ink/15 bg-white px-4 py-2 transition-colors hover:border-ink/45">LinkedIn</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div class="relative flex justify-center px-4 pb-4 sm:pb-8 md:pb-10">
        <a href="#demo" class="demo-cue glass hero-in fade-up group flex items-center gap-3 py-2 pr-2 pl-5 text-[16px] font-semibold text-ink sm:flex-col sm:px-7 sm:pt-4 sm:pb-5 sm:text-[17px]" style="--delay: 900ms">
          {t.hero.cue}
          <span class="flex size-10 items-center justify-center rounded-full sm:size-14 border border-ink/15 bg-white shadow-[0_10px_24px_-14px_rgba(20,24,46,0.5)] transition-colors group-hover:border-ink group-hover:bg-ink group-hover:text-white">
            <svg viewBox="0 0 24 24" width="26" height="26" class="size-5 sm:size-[26px]" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </span>
        </a>
      </div>
    </section>

    <section id="demo" aria-label={t.demo} class="snap flex flex-col justify-center">
      <div class="mx-auto w-full max-w-[1680px] px-4 py-6 md:px-6">
        <Playground client:load lang={lang} />
      </div>
    </section>

    <section id="experience" class="snap flex flex-col justify-center">
      <div class="mx-auto grid w-full max-w-[1400px] gap-x-14 gap-y-6 px-4 py-2 md:px-6 lg:grid-cols-12 [@media(min-height:860px)]:py-12">
        <div class="glass p-5 lg:col-span-7 [@media(min-height:860px)]:md:p-7">
          <Reveal text={t.nav.experience} class="section-in wide-type text-[clamp(1.9rem,3.2vw,2.8rem)] leading-none font-extrabold tracking-tight" />
          <ol class="mt-3 divide-y divide-ink/10 border-t border-ink/10 [@media(min-height:860px)]:mt-6">
            {t.experience.map((w) => (
              <li class:list={['py-2.5 [@media(min-height:860px)]:py-5', w.current && 'now']}>
                <span class="when text-[14px] font-semibold text-muted tabular-nums">
                  {w.years}<span class="font-medium text-muted/80"> · {w.duration}</span>
                </span>
                <h3 class="mt-1 text-[18px] leading-snug font-bold">
                  {w.role}
                  {w.org && (
                    <>
                      ,{' '}
                      <a href={w.href} class="underline decoration-ink/25 underline-offset-4 hover:decoration-ink">{w.org}</a>
                    </>
                  )}
                </h3>
                <p class="mt-1 max-w-[76ch] text-[15.5px] leading-normal text-ink/80 [@media(min-height:860px)]:mt-1.5 [@media(min-height:860px)]:leading-relaxed">{w.text}</p>
              </li>
            ))}
          </ol>
        </div>

        <div id="studies" class="glass scroll-mt-6 p-5 lg:col-span-5 [@media(min-height:860px)]:md:p-7">
          <Reveal text={t.nav.studies} delay={120} class="section-in wide-type text-[clamp(1.9rem,3.2vw,2.8rem)] leading-none font-extrabold tracking-tight" />
          <ol class="mt-3 divide-y divide-ink/10 border-t border-ink/10 [@media(min-height:860px)]:mt-6">
            {t.studies.map((s) => (
              <li class:list={['py-2.5 [@media(min-height:860px)]:py-5', s.current && 'now']}>
                <span class="when text-[14px] font-semibold text-muted tabular-nums">{s.years}</span>
                <h3 class="mt-1 text-[18px] leading-snug font-bold">{s.role}, {s.org}</h3>
                {s.text && <p class="mt-1 max-w-[60ch] text-[15.5px] leading-normal text-ink/80 [@media(min-height:860px)]:mt-1.5 [@media(min-height:860px)]:leading-relaxed">{s.text}</p>}
                {s.link && (
                  <a href={s.link.href} class="mt-1.5 inline-block text-[15.5px] font-semibold text-traffic underline decoration-traffic/30 underline-offset-4 hover:decoration-traffic">
                    {s.link.label}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section id="contact" class="snap flex flex-col">
      <div class="mx-auto flex w-full max-w-[1400px] flex-1 flex-col justify-center px-4 py-6 md:px-6 [@media(min-height:860px)]:py-10">
        <div class="mx-auto grid w-full max-w-[820px] gap-10 rounded-[26px] bg-ink px-6 py-10 text-white md:px-10 md:py-12 lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-center">
          <div>
            <Reveal text={t.contact.title} class="section-in wide-type text-[clamp(2rem,4vw,3.4rem)] leading-none font-extrabold tracking-tight" />
            <p class="mt-4 max-w-[52ch] text-[18px] leading-relaxed text-white/80">{t.contact.lead}</p>
            <a
              href={`mailto:${t.contact.email}`}
              class="mt-5 inline-block text-[clamp(1.15rem,1.9vw,1.5rem)] leading-tight font-bold break-all underline decoration-white/30 underline-offset-4 hover:decoration-white"
            >
              {t.contact.email}
            </a>
            <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-[17px] font-semibold">
              <li><a href="https://danielegreco.com/linkedin" class="underline decoration-white/30 underline-offset-4 hover:decoration-white">LinkedIn</a></li>
              <li><a href="https://danielegreco.com/github" class="underline decoration-white/30 underline-offset-4 hover:decoration-white">GitHub</a></li>
            </ul>
          </div>
          <div>
            <img
              src="/images/daniele-480.webp"
              srcset="/images/daniele-480.webp 480w, /images/daniele-960.webp 960w"
              sizes="(min-width: 1024px) 320px, 70vw"
              width="480"
              height="480"
              alt="Daniele Greco"
              loading="lazy"
              class="aspect-square w-full max-w-[17rem] rounded-[22px] bg-white object-cover"
            />
            <p class="mt-5 max-w-[17rem] text-[15px] leading-relaxed text-white/75">{t.contact.about}</p>
          </div>
        </div>
      </div>
      <footer class="mx-auto flex w-full max-w-[1400px] justify-center px-4 pb-6 md:px-6">
        <!-- Smaller on phones, so the Italian text too stays on one line. -->
        <div class="glass flex flex-wrap justify-center gap-x-2 gap-y-1 px-4 py-3 text-[12px] text-muted sm:px-5 sm:text-[14px]">
          <span>© {year} Daniele Greco</span>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/DaniGreco/website" class="underline decoration-ink/20 underline-offset-4 hover:text-ink">
            {t.contact.source}
          </a>
        </div>
      </footer>
    </section>
  </main>
</Base>

<script>
  import { start as startBackground } from '../scripts/backgrounds/flow.js';

  const canvas = document.getElementById('background');
  if (canvas instanceof HTMLCanvasElement) startBackground(canvas);

  // Entrances: the hero plays on load, section titles when their screen comes into view.
  requestAnimationFrame(() => {
    for (const el of document.querySelectorAll('.hero-in')) el.classList.add('in');
  });
  const reveal = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('in');
        reveal.unobserve(entry.target);
      }
    },
    { threshold: 0.6 },
  );
  for (const el of document.querySelectorAll('.section-in')) reveal.observe(el);

  // Top bar: a hairline once the page scrolls, and the current section underlined.
  const bar = document.getElementById('top-bar');
  const onScroll = () => bar?.toggleAttribute('data-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // One underline per screen: Experience and Studies share a screen, so they share the line.
  const groups = [...document.querySelectorAll('.nav-group')];
  let here = 'top';
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        here = entry.target.id;
        for (const group of groups) {
          const current = group.getAttribute('data-section') === entry.target.id;
          group.toggleAttribute('data-current', current);
          for (const link of group.querySelectorAll('a')) link.setAttribute('aria-current', String(current));
        }
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  for (const id of ['top', 'demo', 'experience', 'contact']) {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  }

  // The address follows the screen you scroll to, so a reload lands where you were. It waits for
  // scrolling to settle, so it never overrides the address the page was opened with.
  let settle = 0;
  const followHash = () => {
    const hash = here === 'top' ? '' : `#${here}`;
    if (location.hash === hash || (here === 'experience' && location.hash === '#studies')) return;
    history.replaceState(null, '', `${location.pathname}${location.search}${hash}`);
  };
  window.addEventListener('scroll', () => {
    clearTimeout(settle);
    settle = setTimeout(followHash, 150);
  }, { passive: true });

  // Where Experience and Studies sit side by side, Studies lands exactly where Experience does.
  const sideBySide = matchMedia('(min-width: 1024px)');
  document.querySelector('a[href="#studies"]')?.addEventListener('click', (e) => {
    if (!sideBySide.matches) return;
    e.preventDefault();
    document.getElementById('experience')?.scrollIntoView({ block: 'start' });
    history.replaceState(null, '', '#studies');
  });

  // Switching language keeps the screen you are on: both pages use the same section ids.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]')) {
    const path = link.getAttribute('href')?.split('#')[0];
    link.addEventListener('click', () => {
      link.href = here === 'top' ? `${path}` : `${path}#${here}`;
    });
  }
</script>
