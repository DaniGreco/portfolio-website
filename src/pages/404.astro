---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found, Daniele Greco" description="This page does not exist.">
  <main class="mx-auto flex min-h-dvh max-w-[1240px] flex-col justify-center px-4 md:px-6">
    <h1 class="text-[clamp(2.2rem,6vw,4rem)] leading-tight font-extrabold tracking-tight">This page is not on the map.</h1>
    <p class="mt-4 text-[18px] text-ink/80">The address may be old, or mistyped.</p>
    <a href="/" class="mt-8 inline-block text-[18px] font-semibold text-traffic underline decoration-traffic/30 underline-offset-4 hover:decoration-traffic">
      Go to the home page
    </a>
  </main>
</Base>
