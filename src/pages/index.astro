---
import Base from '../layouts/Base.astro';
import Playground from '../components/Playground/Playground.jsx';

const year = new Date().getFullYear();

const experience = [
  {
    years: '2026 – now',
    role: 'Software architect',
    org: 'flAi',
    href: 'https://flai-analytics.com',
    text: 'flAi builds decision-support tools for aviation and mobility. I run the platform underneath: GPU servers on-prem, cloud fleets, single sign-on, backups and monitoring. On top of it I build products: a document assistant for operations staff, AI agents and analytics dashboards.',
  },
  {
    years: '2026 – now',
    role: 'Freelance software engineer',
    text: 'Software design, development and technical consulting, as an independent professional.',
  },
  {
    years: 'Jul – Nov 2025',
    role: 'Undergraduate research fellow',
    org: 'University of Bergamo',
    href: 'https://www.unibg.it',
    text: "Research for MOST, the Italian National Center for Sustainable Mobility, about transport modes, their technical characteristics and user behaviour. I ran a market analysis of the Italian e-bike sector that went into the project's deliverables.",
  },
  {
    years: '2023 – 2024',
    role: 'CPM consultant',
    org: 'Avvale',
    href: 'https://www.avvale.com',
    text: 'Modules for OneStream, a corporate performance management platform, written in Visual Basic and .NET.',
  },
];

const studies = [
  {
    years: 'From Nov 2026',
    role: 'PhD in Technology, Innovation and Management',
    org: 'University of Bergamo',
    text: 'Research on using generative AI to solve optimisation problems.',
  },
  {
    years: '2023 – 2026',
    role: 'MSc in Computer Engineering',
    org: 'University of Bergamo',
    text: "Thesis with Prof. Angelo Gargantini: HaiSIM, a simulator of a radiology reading room with an AI in it, to study how AI changes waiting times and the radiologists' decisions.",
    link: { href: 'https://github.com/DaniGreco/hai-sim', label: 'Thesis code on GitHub' },
  },
  {
    years: '2019 – 2023',
    role: 'BSc in Computer Science and Engineering',
    org: 'University of Bergamo',
    text: 'Thesis with Prof. Paolo Malighetti: a web scraper in JavaScript, Node.js and Docker that collects e-bike components from Italian shops.',
    link: { href: 'https://github.com/DaniGreco/BSc_Thesis', label: 'Thesis code on GitHub' },
  },
];

// Experience and Studies share one screen, so both links point to it and light up together.
const nav = [
  { href: '#demo', label: 'Demo', section: 'demo' },
  { href: '#experience', label: 'Experience', section: 'experience' },
  { href: '#studies', label: 'Studies', section: 'experience' },
  { href: '#contact', label: 'Contact', section: 'contact' },
];
---

<Base
  title="Daniele Greco, system architect and software engineer"
  description="I build and run the infrastructure that airports and factories rely on. Explore an interactive model of it."
>
  <header id="top-bar" class="sticky top-0 z-50 h-(--header) border-b border-transparent bg-paper/85 backdrop-blur-md transition-colors data-[scrolled]:border-ink/10">
    <div class="mx-auto flex h-full max-w-[1400px] items-center justify-between px-4 md:px-6">
      <a href="#top" class="wide-type text-[17px] font-extrabold tracking-tight whitespace-nowrap" aria-label="Daniele Greco, back to the top">
        <span class="sm:hidden" aria-hidden="true">DG</span><span class="hidden sm:inline">Daniele Greco</span>
      </a>
      <nav aria-label="Sections" class="flex gap-3.5 text-[14px] font-semibold text-ink/65 sm:gap-6 sm:text-[15px]">
        {nav.map((n) => (
          <a href={n.href} data-section={n.section} class="py-1 decoration-2 underline-offset-[6px] hover:text-ink aria-[current=true]:text-ink aria-[current=true]:underline">
            {n.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <main>
    <section id="top" class="snap relative flex flex-col justify-center overflow-hidden">
      <canvas id="field" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
      <div class="relative mx-auto grid w-full max-w-[1400px] gap-8 px-4 py-16 md:px-6 lg:grid-cols-12 lg:items-end">
        <h1 class="wide-type text-[clamp(2.2rem,4.6vw,4.3rem)] leading-[1.03] font-extrabold tracking-[-0.02em] text-balance lg:col-span-8">
          I build and run the infrastructure that airports and factories rely on.
        </h1>
        <p class="max-w-[44ch] text-[18px] leading-relaxed text-ink/80 lg:col-span-4 lg:pb-2">
          PhD student with several years of experience as a system architect and software engineer, based in Bergamo,
          Italy. I build and manage all kinds of clusters, from on-premise server rooms to cloud-native environments,
          following the highest security standards.
        </p>
      </div>
    </section>

    <section id="demo" aria-label="Infrastructure demo" class="snap flex flex-col justify-center">
      <div class="mx-auto w-full max-w-[1680px] px-4 py-6 md:px-6">
        <Playground client:load />
      </div>
    </section>

    <section id="experience" class="snap flex flex-col justify-center">
      <div class="mx-auto grid w-full max-w-[1400px] gap-x-14 gap-y-14 px-4 py-4 md:px-6 lg:grid-cols-12 [@media(min-height:860px)]:py-12">
        <div class="lg:col-span-7">
          <h2 class="wide-type text-[clamp(1.9rem,3.2vw,2.8rem)] leading-none font-extrabold tracking-tight">Experience</h2>
          <ol class="mt-4 divide-y divide-ink/10 border-t border-ink/10 [@media(min-height:860px)]:mt-6">
            {experience.map((w) => (
              <li class="py-3 [@media(min-height:860px)]:py-5">
                <span class="text-[14px] font-semibold text-muted tabular-nums">{w.years}</span>
                <h3 class="mt-1 text-[18px] leading-snug font-bold">
                  {w.role}
                  {w.org && (
                    <>
                      ,{' '}
                      <a href={w.href} class="underline decoration-ink/25 underline-offset-4 hover:decoration-ink">{w.org}</a>
                    </>
                  )}
                </h3>
                <p class="mt-1.5 max-w-[76ch] text-[15.5px] leading-relaxed text-ink/80">{w.text}</p>
              </li>
            ))}
          </ol>
        </div>

        <div id="studies" class="scroll-mt-6 lg:col-span-5">
          <h2 class="wide-type text-[clamp(1.9rem,3.2vw,2.8rem)] leading-none font-extrabold tracking-tight">Studies</h2>
          <ol class="mt-4 divide-y divide-ink/10 border-t border-ink/10 [@media(min-height:860px)]:mt-6">
            {studies.map((s) => (
              <li class="py-3 [@media(min-height:860px)]:py-5">
                <span class="text-[14px] font-semibold text-muted tabular-nums">{s.years}</span>
                <h3 class="mt-1 text-[18px] leading-snug font-bold">{s.role}, {s.org}</h3>
                {s.text && <p class="mt-1.5 max-w-[60ch] text-[15.5px] leading-relaxed text-ink/80">{s.text}</p>}
                {s.link && (
                  <a href={s.link.href} class="mt-1.5 inline-block text-[15.5px] font-semibold text-traffic underline decoration-traffic/30 underline-offset-4 hover:decoration-traffic">
                    {s.link.label}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section id="contact" class="snap flex flex-col">
      <div class="mx-auto flex w-full max-w-[1400px] flex-1 flex-col justify-center px-4 py-10 md:px-6">
        <div class="grid gap-10 rounded-[26px] bg-ink px-6 py-12 text-white md:px-12 md:py-16 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-8">
            <h2 class="wide-type text-[clamp(2rem,4vw,3.4rem)] leading-none font-extrabold tracking-tight">Contact</h2>
            <p class="mt-4 max-w-[52ch] text-[18px] leading-relaxed text-white/80">Email is the fastest way to reach me.</p>
            <a
              href="mailto:info@danielegreco.com"
              class="wide-type mt-6 inline-block text-[clamp(1.5rem,4.4vw,3rem)] leading-tight font-extrabold tracking-tight break-all underline decoration-white/30 underline-offset-[6px] hover:decoration-white"
            >
              info@danielegreco.com
            </a>
            <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-[17px] font-semibold">
              <li><a href="/linkedin" class="underline decoration-white/30 underline-offset-4 hover:decoration-white">LinkedIn</a></li>
              <li><a href="/github" class="underline decoration-white/30 underline-offset-4 hover:decoration-white">GitHub</a></li>
            </ul>
          </div>
          <div class="lg:col-span-4">
            <img
              src="/images/daniele-480.webp"
              srcset="/images/daniele-480.webp 480w, /images/daniele-960.webp 960w"
              sizes="(min-width: 1024px) 320px, 70vw"
              width="480"
              height="480"
              alt="Daniele Greco"
              loading="lazy"
              class="aspect-square w-full max-w-[300px] rounded-[22px] bg-white object-cover"
            />
            <p class="mt-5 max-w-[40ch] text-[16px] leading-relaxed text-white/75">
              Curiosity drives most of what I do. Besides technology I read about maths, finance, music, cinema and
              philosophy, and I like taking ideas from one field into another.
            </p>
          </div>
        </div>
      </div>
      <footer class="mx-auto flex w-full max-w-[1400px] flex-wrap justify-between gap-3 px-4 pb-8 text-[14px] text-muted md:px-6">
        <span>© {year} Daniele Greco</span>
        <a href="https://github.com/DaniGreco/portfolio-website" class="underline decoration-ink/20 underline-offset-4 hover:text-ink">
          Source code on GitHub
        </a>
      </footer>
    </section>
  </main>
</Base>

<script>
  import { startField } from '../scripts/field.js';

  const canvas = document.getElementById('field');
  if (canvas instanceof HTMLCanvasElement) startField(canvas);

  // Top bar: a hairline once the page scrolls, and the current section underlined.
  const bar = document.getElementById('top-bar');
  const onScroll = () => bar?.toggleAttribute('data-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const links = [...document.querySelectorAll('[data-section]')];
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of links) link.setAttribute('aria-current', String(link.getAttribute('data-section') === entry.target.id));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  for (const id of ['top', 'demo', 'experience', 'contact']) {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  }
</script>
